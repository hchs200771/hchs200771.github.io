---
import { ClientRouter } from 'astro:transitions';
import { SITE } from '../consts';
import { personId } from '../seo';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 分享預覽圖（public/ 底下的路徑），沒給就用全站預設圖 */
  image?: string;
  imageAlt?: string;
  /** 文章頁用 article，社群平台會顯示發佈時間 */
  type?: 'website' | 'article';
  publishedTime?: Date;
  modifiedTime?: Date;
  /** 額外的 JSON-LD 結構化資料（例如文章頁的 BlogPosting、麵包屑） */
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
}

const {
  title,
  description = SITE.description,
  image = SITE.ogImage,
  imageAlt = title ?? SITE.name,
  type = 'website',
  publishedTime,
  modifiedTime,
  jsonLd,
} = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);
const imageUrl = new URL(image, Astro.site);
const extraLd = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  '@id': personId(Astro.site!),
  name: SITE.author,
  description: SITE.description,
  jobTitle: 'AI Coding Coach',
  url: Astro.site?.toString(),
  sameAs: Object.values(SITE.social).filter(Boolean),
};

const navItems = [
  { href: '/', label: '首頁' },
  { href: '/portfolio/', label: '作品集' },
  { href: '/blog/', label: '部落格' },
  { href: '/about/', label: '關於我' },
  { href: '/contact/', label: '聯絡' },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={SITE.name} href="/rss.xml" />
    <meta name="author" content={SITE.author} />

    <meta property="og:type" content={type} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_TW" />
    <meta property="og:image" content={imageUrl} />
    <meta property="og:image:alt" content={imageAlt} />
    {publishedTime && <meta property="article:published_time" content={publishedTime.toISOString()} />}
    {modifiedTime && <meta property="article:modified_time" content={modifiedTime.toISOString()} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={imageUrl} />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    {extraLd.map((ld) => <script type="application/ld+json" set:html={JSON.stringify(ld)} />)}
    <ClientRouter />
  </head>
  <body>
    <div class="read-progress" aria-hidden="true" transition:persist></div>
    <header class="site-header">
      <nav class="container">
        <a href="/" class="logo">{SITE.title}<span class="logo-dot">.</span></a>
        <ul class="nav-links">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={{
                    active:
                      item.href === '/'
                        ? currentPath === '/'
                        : currentPath.startsWith(item.href),
                  }}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {new Date().getFullYear()} {SITE.author}</p>
        <div class="footer-links">
          <a href={SITE.social.github} target="_blank" rel="noopener">GitHub</a>
          <a href={SITE.social.facebook} target="_blank" rel="noopener">Facebook</a>
          <a href={SITE.social.instagram} target="_blank" rel="noopener">Instagram</a>
          {SITE.social.line && <a href={SITE.social.line} target="_blank" rel="noopener">LINE</a>}
        </div>
      </div>
    </footer>

    <script>
      // 全站動態：捲動進場、文章閱讀進度條。
      // 用 ClientRouter 換頁時 script 只會執行一次，所以每次換頁都靠 astro:page-load 重新綁定。
      const REVEAL_SELECTOR = [
        '.section',
        '.cta-band',
        '.card',
        '.post-item',
        '.pain-card',
        '.service-card',
        '.quote-card',
        '.contact-card',
        '.prose > h2',
        '.prose > pre',
        '.prose > blockquote',
        '.demo',
      ].join(',');

      let observer: IntersectionObserver | undefined;

      function setupReveal() {
        observer?.disconnect();
        if (matchMedia('(prefers-reduced-motion: reduce)').matches) return;

        observer = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              observer?.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px' },
        );

        document.querySelectorAll<HTMLElement>(REVEAL_SELECTOR).forEach((el) => {
          // 同一排的卡片依序錯開進場
          const siblings = el.parentElement ? [...el.parentElement.children] : [];
          const index = siblings.filter((s) => s.matches(REVEAL_SELECTOR)).indexOf(el);
          el.style.setProperty('--reveal-delay', `${Math.min(index, 6) * 70}ms`);
          el.classList.add('reveal');
          observer?.observe(el);
        });
      }

      function updateProgress() {
        const bar = document.querySelector<HTMLElement>('.read-progress');
        const article = document.querySelector<HTMLElement>('article.prose');
        if (!bar) return;
        if (!article) {
          bar.style.transform = 'scaleX(0)';
          return;
        }
        const rect = article.getBoundingClientRect();
        const total = rect.height - window.innerHeight;
        const ratio = total > 0 ? Math.min(Math.max(-rect.top / total, 0), 1) : 1;
        bar.style.transform = `scaleX(${ratio})`;
      }

      document.addEventListener('astro:page-load', () => {
        setupReveal();
        updateProgress();
      });
      window.addEventListener('scroll', updateProgress, { passive: true });
      window.addEventListener('resize', updateProgress);
    </script>
  </body>
</html>
