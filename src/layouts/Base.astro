---
import { SITE } from '../consts';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
  /** 額外的 JSON-LD 結構化資料（例如文章頁的 Article） */
  jsonLd?: Record<string, unknown>;
}

const { title, description = SITE.description, jsonLd } = Astro.props;
const pageTitle = title ? `${title} | ${SITE.name}` : SITE.name;
const canonical = new URL(Astro.url.pathname, Astro.site);

const personLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  jobTitle: 'AI Coding Coach',
  url: Astro.site?.toString(),
  sameAs: Object.values(SITE.social),
};

const navItems = [
  { href: '/', label: '首頁' },
  { href: '/portfolio/', label: '作品集' },
  { href: '/blog/', label: '部落格' },
  { href: '/about/', label: '關於我' },
  { href: '/contact/', label: '聯絡' },
];
const currentPath = Astro.url.pathname;
---

<!doctype html>
<html lang="zh-TW">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="sitemap" href="/sitemap-index.xml" />

    <meta property="og:type" content="website" />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content={SITE.name} />
    <meta property="og:locale" content="zh_TW" />
    <meta name="twitter:card" content="summary_large_image" />

    <script type="application/ld+json" set:html={JSON.stringify(personLd)} />
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <header class="site-header">
      <nav class="container">
        <a href="/" class="logo">{SITE.title}<span class="logo-dot">.</span></a>
        <ul class="nav-links">
          {
            navItems.map((item) => (
              <li>
                <a
                  href={item.href}
                  class:list={{
                    active:
                      item.href === '/'
                        ? currentPath === '/'
                        : currentPath.startsWith(item.href),
                  }}
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>
    </header>

    <main class="container">
      <slot />
    </main>

    <footer class="site-footer">
      <div class="container footer-inner">
        <p>© {new Date().getFullYear()} {SITE.author}</p>
        <div class="footer-links">
          <a href={SITE.social.github} target="_blank" rel="noopener">GitHub</a>
          <a href={SITE.social.facebook} target="_blank" rel="noopener">Facebook</a>
          <a href={SITE.social.instagram} target="_blank" rel="noopener">Instagram</a>
          <a href={SITE.social.line} target="_blank" rel="noopener">LINE</a>
        </div>
      </div>
    </footer>
  </body>
</html>
