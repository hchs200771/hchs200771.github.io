---
import Base from '../layouts/Base.astro';
import { SITE } from '../consts';
---

<Base
  title="聯絡我"
  description={`想接案合作或學 AI Coding？透過${SITE.social.line ? ' LINE、' : ' '}Email 或社群媒體找到我。`}
>
  <div class="page-head">
    <h1>聯絡我</h1>
    <p>不管是接案合作、AI Coding 問題，還是單純想聊聊，都歡迎找我。</p>
  </div>

  <div class="contact-grid">
    {
      SITE.social.line && (
        <div class="contact-card">
          <h3>LINE 官方帳號</h3>
          <p>台灣朋友加 LINE 最方便，一對一直接問，回覆最快。</p>
          {SITE.lineQr && (
            <img class="line-qr" src={SITE.lineQr} alt="LINE 官方帳號 QR Code，用手機掃描加好友" width="160" height="160" loading="lazy" />
          )}
          <a class="btn primary" href={SITE.social.line} target="_blank" rel="noopener">
            加入好友
          </a>
        </div>
      )
    }

    <div class="contact-card">
      <h3>Email</h3>
      <p>正式的合作邀約或詳細需求，歡迎寄信給我。</p>
      <a class="btn" href={`mailto:${SITE.email}`}>{SITE.email}</a>
    </div>

    <div class="contact-card">
      <h3>社群媒體</h3>
      <p>想先認識我是誰，可以從這裡開始。</p>
      <div class="tag-row">
        <a class="btn" href={SITE.social.facebook} target="_blank" rel="noopener"
          >Facebook</a
        >
        <a class="btn" href={SITE.social.instagram} target="_blank" rel="noopener"
          >Instagram</a
        >
        <a class="btn" href={SITE.social.github} target="_blank" rel="noopener"
          >GitHub</a
        >
      </div>
    </div>
  </div>
</Base>
