---
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import PortfolioCard from '../components/PortfolioCard.astro';
import { SITE } from '../consts';

const projects = (await getCollection('portfolio'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const posts = (await getCollection('blog', ({ data }) => !data.draft))
  .sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
  .slice(0, 3);
---

<Base>
  <section class="hero">
    <p class="kicker">AI CODING COACH</p>
    <h1>你有想法，<br />我用 AI 幫你快速做出來。</h1>
    <p class="lede">
      我是 {SITE.author}，後端工程師出身的 AI Coding 教練。我用 AI Coding
      的方式接案開發，也寫文章分享 Vibe Coding 的實戰工具與心得，
      讓更多人能把想法變成真正能用的產品。
    </p>
    <div class="cta-row">
      <a class="btn primary" href="/portfolio/">看我的作品</a>
      <a class="btn" href="/contact/">聯絡我</a>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>這些狀況，你熟嗎？</h2>
    </div>
    <div class="pain-grid">
      <div class="pain-card">
        <p class="pain-q">「我有個點子，但不會寫程式，找外包又貴又怕被騙。」</p>
        <p class="pain-a">→ 我用 AI Coding 開發，速度快，過程全透明。</p>
      </div>
      <div class="pain-card">
        <p class="pain-q">「我自己用 AI 寫了一半，結果愈改愈爛，整個卡死。」</p>
        <p class="pain-a">→ 專案救援是我的日常，幫你把卡住的專案救回來。</p>
      </div>
      <div class="pain-card">
        <p class="pain-q">「我想學 Vibe Coding，但網路上資訊太雜，不知道從哪開始。」</p>
        <p class="pain-a">→ 看我的教學文章，或直接找我一對一陪跑。</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>我能幫你什麼</h2>
    </div>
    <div class="services-grid">
      <div class="service-card">
        <div class="service-icon">🚀</div>
        <h3>接案開發</h3>
        <p>網站、後端 API、自動化工具。用 AI Coding 加速開發，把你的想法快速變成能用的產品。</p>
      </div>
      <div class="service-card">
        <div class="service-icon">🧭</div>
        <h3>AI Coding 教學</h3>
        <p>一對一教你用 Claude Code 等工具寫程式，從零開始也沒問題，學會自己把東西做出來。</p>
      </div>
      <div class="service-card">
        <div class="service-icon">🛟</div>
        <h3>專案救援</h3>
        <p>自己 Vibe Coding 到一半卡住了？我幫你診斷、重整架構，讓專案繼續往前走。</p>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>精選作品</h2>
      <a href="/portfolio/">全部作品 →</a>
    </div>
    <div class="gallery">
      {projects.map((p) => <PortfolioCard project={p} />)}
    </div>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>最新文章</h2>
      <a href="/blog/">全部文章 →</a>
    </div>
    <ul class="post-list">
      {
        posts.map((post) => (
          <li class="post-item">
            <a href={`/blog/${post.id}/`}>
              <p class="meta">
                {post.data.pubDate.toISOString().slice(0, 10)}
              </p>
              <h3>{post.data.title}</h3>
              <p>{post.data.description}</p>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="section">
    <div class="section-head">
      <h2>合作過的人怎麼說</h2>
    </div>
    <div class="quote-grid">
      <!-- TODO: 換成真實客戶見證，姓名可用暱稱 + 身分，例如「小美・電商創業者」 -->
      <blockquote class="quote-card">
        <p>「原本以為要等一個月，結果一週就看到可以動的版本，溝通也很順暢。」</p>
        <footer>— 客戶見證佔位，合作後替換</footer>
      </blockquote>
      <blockquote class="quote-card">
        <p>「跟著 Max 學了兩次，我自己就把公司內部的小工具做出來了。」</p>
        <footer>— 學員見證佔位，合作後替換</footer>
      </blockquote>
    </div>
  </section>

  <section class="cta-band">
    <h2>有想法想做出來？</h2>
    <p>加 LINE 直接聊，免費評估你的需求，不用先準備什麼。</p>
    <div class="cta-row">
      <a class="btn primary" href={SITE.social.line} target="_blank" rel="noopener"
        >加 LINE 聊聊</a
      >
      <a class="btn" href="/contact/">其他聯絡方式</a>
    </div>
  </section>
</Base>
