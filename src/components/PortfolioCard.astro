---
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'portfolio'>;
}

const { project } = Astro.props;
const { title, description, url, cover, tags, client } = project.data;
---

<article class="card">
  <a class="card-link" href={`/portfolio/${project.id}/`}>
    <img src={cover} alt={`${title} 截圖`} loading="lazy" />
    <div class="card-body">
      <h3>{title}</h3>
      <p>{description}</p>
      <div class="tag-row">
        {tags.map((t) => <span class="tag">{t}</span>)}
        {client && <span class="badge-offline">私人接案</span>}
        {!url && !client && <span class="badge-offline">開發中・尚未上線</span>}
      </div>
    </div>
  </a>
</article>
